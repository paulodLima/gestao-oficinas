# Gmail SMTP (produção ou e-mails reais)
# Gere uma senha de aplicativo de 16 caracteres na Conta Google com a verificação em duas etapas ativa.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=sua-senha-de-aplicativo
# MAIL_AUTH=true
# MAIL_TLS=true
# MAIL_FROM=seu-email@gmail.com

# SMTP corporativo CentrUS (ambiente de trabalho)
# Informe abaixo o endereço autorizado para envio pela sua empresa.
# MAIL_HOST=smtp.centrus.org.br
# MAIL_PORT=25
# MAIL_AUTH=false
# MAIL_TLS=false
# MAIL_FROM=seu-email@centrus.org.br
